[alias]
    aliases = config --get-regexp ^alias
    amend = commit --amend --no-edit
    au = add -u
    bed = branch --edit-description
    br = branch -vv
    bra = branch -vv --all
    ca = commit -a
    cc = rev-list HEAD --count
    cca = rev-list --all --count
    ci = commit -v
    cleanall = clean -fd # removes untracked files only, ignored files are kept
    cm = commit -m
    cma = commit -a -m
    co = checkout
    credit = shortlog -sn HEAD
    # delete local branches already merged into their upstream, e.g. git dbm 'origin/*'
    dbm = branch --delete-merged
    dc = diff --cached
    dcs = diff --cached --stat
    dcw = diff --cached --color-words
    dh = diff HEAD~
    dhs = diff HEAD~ --stat
    dhw = diff HEAD~ --color-words
    di = diff
    dis = diff --stat
    diw = diff --color-words
    du = diff @{u}...
    dus = diff @{u}... --stat
    duw = diff @{u}... --color-words
    empty-tree-hash = hash-object -t tree /dev/null
    f = fetch --tags
    fa = fetch --all --tags
    ff = merge --ff-only
    gr = log --graph --format=line # graph
    gra = log --graph --format=line --all # graph all
    grad = log --graph --format=detail --all # graph all in detail
    grd = log --graph --format=detail # graph detail
    grp = grep -C 1
    l = log --decorate --pretty=format:'%C(auto)%h%C(auto) %C(auto,cyan)(%cd)%Creset %s %C(auto)%d%C(auto) %C(auto,magenta)[%an]%C(auto)' --date='format:%Y-%m-%d %H:%M'
    last = log -1 HEAD --stat
    lg = log -p
    linecredit = ! "lc() { git ls-tree --name-only -z -r HEAD | xargs -0 -n1 git diff --no-index --numstat /dev/null 2>/dev/null | grep -v '^-' | cut -f 3- | cut -d ' ' -f 3- | xargs -n1 git blame --line-porcelain | grep '^author ' | cut -d ' ' -f 2- | sort | uniq -c | sort -nr; }; lc"
    list = ls-tree -r HEAD --name-only
    ll = l --graph --branches --tags
    lll = l --graph --all
    llog = log --date=local
    noff = merge --no-ff
    put = push origin HEAD
    root = rev-parse --show-toplevel
    rs = restore
    s = status -sb
    sf = show --format=fuller --show-signature
    sfs = show --format=fuller --stat
    sfw = show --format=fuller --color-words
    st = status
    staash = stash --include-untracked
    stats = diff --stat "4b825dc642cb6eb9a060e54bf8d69288fbee4904" # line stats for all tracked files
    stsh = stash --keep-index
    sw = switch
    # show tags with their types, without mark - lightweight, `a` - annotated, `b` - blob
    tags = for-each-ref --format='%(if:equals=tag)%(objecttype)%(then)a %(else)%(if:equals=blob)%(objecttype)%(then)b %(else)  %(end)%(end)%(align:20,right)%(refname:short)%09%(objectname:short)%(end)%09%(if:equals=tag)%(objecttype)%(then)@%(object) %(contents:subject)%(else)%(end)' --sort=taggerdate refs/tags
    tar = ! "tar() { git archive --format tar --prefix=\"${PWD##*/}/\" HEAD -o ${1}; }; tar"
    targz = ! "targz() { git archive --format tar.gz --prefix=\"${PWD##*/}/\" HEAD -o ${1}; }; targz"
    unstage = restore --staged --
    up = pull --rebase
    update-submodules = submodule update --init --recursive
    upgrade-submodules = submodule update --init --remote
    versions = tag -l --sort=version:refname
    w = log --raw --no-merges
    whatis = show -s --pretty='tformat:%h (%s, %ad)' --date=short
    whois = "!sh -c 'git log -i -1 --pretty=\"format:%an <%ae>\n\" --author=\"$1\"' -"
    zip = ! "zip() { git archive --format zip --prefix=\"${PWD##*/}/\" HEAD -o ${1}; }; zip"
    # usage:
    # $ git squash N
    # N is number of last commits to squash, inclusive
    squash = "!f(){ git reset --soft HEAD~${1} && git commit --edit -m\"$(git log --format=%B --reverse HEAD..HEAD@{1})\"; };f"
    # usage:
    # $ git squash-all -m 'a new start'
    # $ git push -f
    squash-all = "!f(){ git reset $(git commit-tree \"HEAD^{tree}\" \"$@\");};f"
    versionbump = "!f() { cd -- \"${GIT_PREFIX:-.}\" || exit 1; V=$(git tag --sort=-version:refname --list 'v[0-9]*' | head -n 1); [ -n \"$V\" ] || V='v0.0.0'; case \"$1\" in .|patch) awkV='{OFS=\".\"; $NF+=1; print $0}';; ..|minor) awkV='{OFS=\".\"; $2+=1; $3=0; print $0}';; ...|major) awkV='{OFS=\".\"; $1=substr($1,2)+1; $2=0; $3=0; print \"v\"$0}';; *) echo 'No version specified. Specify one of patch, minor, or major.' >&2; exit 1;; esac; newV=$(echo \"$V\" | awk -F. \"$awkV\"); shift; printf 'Do you want to tag with version %s?: ' \"$newV\"; read -r tmp; case \"$tmp\" in [Yy]*) git tag -a \"$newV\" -m \"$newV\" \"$@\" && echo \"Tagged version $newV\";; *) exit 1;; esac; }; f"
    # manual version bump
    # usage:
    # `git bump` followed by one, two or three dots, or string patch, minor, or major to tell it which part of the version string to bump
    # . -> patch (1.0.x)
    # .. -> minor (1.x.0)
    # ... -> major (x.0.0)
    # examples:
    # increase patch version, e.g. v1.0.1 -> v1.0.2
    # $ git bump patch
    # increase minor version, e.g. v1.0.1 -> v1.1.0
    # $ git bump ..
    bump = !git versionbump
    # git-cliff version bump
    bump-cliff = "!f() { cd -- \"${GIT_PREFIX:-.}\" || exit 1; if ! command -v git-cliff > /dev/null 2>&1; then echo 'git-cliff not found, exit' >&2; exit 1; fi; ERRVAR=$(git-cliff --bumped-version 2>&1 > /dev/null); if [ -n \"$ERRVAR\" ]; then echo \"$ERRVAR\" >&2; exit 1; fi; V=$(git-cliff --bumped-version) || exit 1; echo \"bumping to $V\"; git tag -a \"$V\" -m \"$V\" \"$@\"; }; f"
[commit]
    verbose = true
[merge]
    conflictstyle = zdiff3
[fetch]
    prune = true
    followRemoteHEAD = warn
[rerere]
    enabled = true
    autoUpdate = true
[rebase]
    autoSquash = true
    updateRefs = true
[user]
    useConfigOnly = true
[init]
    defaultBranch = master
[core]
    excludesFile = ~/.gitignore
[branch]
    sort = -committerdate
[tag]
    sort = version:refname
[column]
    ui = auto
[diff]
    mnemonicPrefix = true
    algorithm = histogram
    colorMoved = plain
    wordRegex = "[^[:space:]]|([[:alnum:]]|UTF_8_GUARD)+"
[color "grep"]
    match = cyan bold
    selected = blue
    context = normal
    filename = magenta
    linenumber = green
    separator = yellow
    function = blue
[pretty]
    line = "%C(auto)%h %<|(60,trunc)%s %C(green)%ad%C(auto)%d"
    detail = "%C(auto)%h %s%n  %C(yellow)by %C(blue)%an %C(magenta)<%ae> [%G?] %C(green)%ad%n %C(auto)%d%n"
[push]
    autoSetupRemote = true
    followTags = true
    useForceIfIncludes = true
[transfer]
    credentialsInUrl = warn
[grep]
    lineNumber = true
[help]
    autoCorrect = 10
# Allow local customizations in the config.local file
[include]
    path = ~/.config/git/config.local
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
    path = ~/.config/git/config.github

