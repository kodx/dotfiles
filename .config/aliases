# package manager agnostic control - pac
# pac - run package manager without options
# pacs - search
# paci - install
# pacd - remove
# pacn - show info
if kxwhich 'lsb_release'; then
    case "$(lsb_release -is)" in
        'ManjaroLinux' | 'Arch')
            AUR_HELPER='paru'
            if kxwhich "$AUR_HELPER"; then
                # shellcheck disable=SC2139 # expansion at definition time is intended
                alias pac="$AUR_HELPER"
            else
                alias pac='sudo pacman'
            fi

            alias pacs='pac -Ss'
            alias paci='pac -S'
            alias pacd='pac -Rcs'
            alias pacn='pac -Si'
            alias pac-clean='pac -Scc'
            ;;
        'Debian' | 'Ubuntu')
            if kxwhich 'aptitude'; then
                alias pac='sudo aptitude'
                alias pacpurge-cached='pac purge \~c'
            else
                alias pac='sudo apt'
            fi

            alias pacpurge-kernels='sudo apt autoremove --purge'

            alias pacs='pac search'
            alias paci='pac install'
            alias pacd='pac purge'
            alias pacn='pac show'
            ;;
        *)
            ;;
    esac
fi

