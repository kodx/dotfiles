# Succeed only when every argument resolves to a command known to the shell.
# Used before defining optional aliases so a missing tool does not create a
# broken alias; returns 1 on the first unresolved argument.
# usage:
# kxwhich make gcc bison && echo 'make, gcc and bison commands found'
kxwhich() {
    for arg in "$@"; do
        command -v "$arg" > /dev/null || return 1
    done
    return 0
}

# Reclaim space in Firefox's SQLite databases with `VACUUM`.
# Requires sqlite3; exits silently when ~/.mozilla does not exist. Refuses to
# touch the databases while Firefox is running, since VACUUM needs exclusive
# access and the browser must not keep them open.
mozillavacuum() {
    kxwhich sqlite3 pgrep find || return 1
    [ -d "$HOME/.mozilla" ] || return 0
    if pgrep '^firefox' > /dev/null 2>&1; then
        printf 'mozillavacuum: close Firefox first\n' >&2
        return 1
    fi
    find "$HOME"/.mozilla -type f -name '*.sqlite' -exec sqlite3 {} VACUUM \;
}

# Define an alias only when the target command exists.
# usage:
# $ aliasifpresent mcd mc '-d'
# sets "alias mcd='mc -d'" if mc command is present
# POSIX sh has no `local`, so the alias name is kept in a prefixed temporary
# variable; the remaining arguments are space-joined to form the alias value.
aliasifpresent() {
    # if number of params lesser than 2
    [ "$#" -lt 2 ] && return 1
    # if command is not available
    kxwhich "$2" || return 1

    _aliasifpresent_name=$1
    shift
    # shellcheck disable=SC2139 # value is built from the arguments on purpose
    alias "$_aliasifpresent_name=$*"
    unset _aliasifpresent_name
}

# Normalise file names in the current directory for safer shell use:
# lowercase them and replace spaces, parentheses, commas, brackets and
# apostrophes with underscores. Files whose sanitised name already exists (or
# is unchanged) are left alone and reported, so a rename never overwrites
# another file.
sanitizefiles() {
    kxwhich tr mv || return 1
    for a in *; do
        file=$(printf '%s' "$a" | tr '[:upper:]' '[:lower:]' | tr ' ' _ | tr '(' _ | tr ')' _ | tr ',' _ | tr '[' _ | tr \' _ | tr ']' _)
        [ "$a" = "$file" ] && continue
        if [ -e "$file" ] || [ -L "$file" ]; then
            printf 'skip: %s -> %s (target exists)\n' "$a" "$file"
            continue
        fi
        mv -- "$a" "$file"
    done
}

# Run a command only if no process with the same name is already running.
# The first argument is the process name checked with `pgrep -x`; the whole
# command line is executed only when no exact match is found. Useful for
# starting daemons from shell startup without creating duplicates.
runonce() {
    kxwhich pgrep || return 1
    [ "$#" -gt 0 ] || return 1
    if ! pgrep -x "$1" > /dev/null 2>&1; then
        "$@"
    fi
}

# Show the full process list with the PID column highlighted in green.
# `ps auxfww` gives a tree with unlimited width (BSD-style, works on Linux
# and BSD). The sed expression uses POSIX character classes and inserts ESC
# via printf, so it does not depend on GNU sed extensions.
psaux() {
    kxwhich ps sed || return 1
    ps auxfww | sed "s/^\([[:alnum:]_]\{1,\}[[:space:]]\{1,\}\)\([[:alnum:]_]\{1,\}\)/\1$(printf '\033')[1;32m\2$(printf '\033')[0m/"
}

